{
  "name": "@xyzshantaram/luacheck-ts",
  "version": "0.1.1",
  "exports": "./src/mod.ts",
  "tasks": {
    "build": "deno bundle --platform=browser --minify --format=esm -o dist/luacheck-ts.bundle.js src/mod.ts",
    "test": "deno test --allow-read=src/testdata",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2020",
      "DOM",
      "deno.ns"
    ]
  },
  "fmt": {
    "exclude": [
      "**/*.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
