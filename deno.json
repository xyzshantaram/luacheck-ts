{
  "name": "@xyzshantaram/luacheck-ts",
  "version": "0.0.1",
  "exports": "./src/mod.ts",
  "tasks": {
    "build": "deno bundle --platform=browser --minify --format=esm -o dist/luacheck-ts.bundle.js src/mod.ts",
    "test": "deno test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "fmt": {
    "exclude": [
      "**/*.md"
    ]
  }
}
